# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored. Never commit real keys.

# --- Neo4j ---------------------------------------------------------------
# AuraDB: copy these from the credentials .txt you download when creating the instance.
# Local Docker alternative: NEO4J_URI=bolt://localhost:7687
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Groq ----------------------------------------------------------------
# Comma-separated, no spaces or quotes. mnemo/llm.py rotates through them on rate limits.
GROQ_API_KEYS=gsk_first_key,gsk_second_key,gsk_third_key

# Model IDs change. Check https://console.groq.com/docs/models
GROQ_AGENT_MODEL=llama-3.3-70b-versatile
GROQ_EXTRACT_MODEL=openai/gpt-oss-120b
# Tried in order when the primary model is rate-limited on every key
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,llama-3.1-8b-instant

# --- Embeddings (local and free; Groq has no embeddings API) ---------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
